# Meta (Facebook) Pixel — dán Pixel ID vào đây hoặc trên Vercel → Environment Variables
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Analytics 4 — tùy chọn, đo traffic/nguồn khách (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity — heatmap / session replay (Project ID)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Sheets webhook form đơn
# 1) Mở scripts/google-sheets-order.gs → làm theo hướng dẫn trong file
# 2) Dán Web app URL vào đây (hoặc Vercel Environment Variables)
GOOGLE_SHEETS_WEBHOOK_URL=
